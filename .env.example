# Exemplo de variáveis de ambiente para desenvolvimento local / produção
# Copie este arquivo para .env e preencha os valores reais

# Perfil e porta da aplicação (produção: prod)
SPRING_PROFILES_ACTIVE=dev
PORT=8080

# Banco de dados MySQL
DB_URL=jdbc:mysql://localhost:3306/huari?createDatabaseIfNotExist=true&serverTimezone=America/Sao_Paulo
DB_USER=root
DB_PASSWORD=root

# Segurança JWT (mínimo 32 caracteres aleatórios em produção)
JWT_SECRET=chave-de-desenvolvimento-troque-em-producao-minimo-32-caracteres

# CORS: domínios do frontend separados por vírgula (ex: https://hu-web.vercel.app)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Administrador inicial (opcional, criado apenas se o e-mail ainda não existir)
ADMIN_NOME=Administrador
ADMIN_EMAIL=
ADMIN_SENHA=

# Integração com IA (Google Gemini)
IA_ENABLED=false
IA_API_KEY=sua_chave_aqui
IA_MODEL=gemini-1.5-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

